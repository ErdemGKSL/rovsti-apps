<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt from apps/contacts/platforms/android/app/src/main/AndroidManifest.xml (E4.1): same components, filters,
     queries and flags; the dev.gpui.* pieces and the vulkan uses-feature are gone. ContactsManifestTest compares the merged
     result with platform/src/test/resources/manifest/contacts.permissions.txt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The people sync runs as a dataSync foreground service while a run is under way (people sync v2 S11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Chat and call on WhatsApp are handed to Rosty Messages and Phone. Only
         apps signed with the same key hold this (whichever installs first defines it). -->
    <uses-permission android:name="dev.rosty.permission.HANDOFF" />
    <permission
        android:name="dev.rosty.permission.HANDOFF"
        android:protectionLevel="signature" />

    <!-- The people cache of X.1b (WhatsApp names and photos) is read by Rosty Phone through PeopleProvider. Same rule as
         HANDOFF: signature level, declared by both apps, so only apps signed with the same key can read it. This app
         owns the provider and needs no uses-permission; :people's library manifest carries one for the readers. -->
    <permission
        android:name="dev.rosty.permission.READ_PEOPLE"
        android:protectionLevel="signature" />

    <!-- WA-R2: the WhatsApp link (gateway address, instance id, connect key) is handed between Rosty apps signed with
         the same key, so linking once links them all (pasting the key stays possible). Signature level, declared by
         every app so whichever installs first defines it. :wa's WaLinkProvider (below) is reachable only with it and
         checks the caller's signing certificate itself. -->
    <permission
        android:name="dev.rosty.permission.WA_LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rosty.permission.WA_LINK" />
    <uses-permission android:name="dev.rosty.permission.READ_PEOPLE" tools:node="remove" />

    <!-- :platform mirrors the permissions of all four apps so lint can check its calls; this app does not use
         location or full-screen intents, so the merge drops them. VIBRATE stays: :design's haptics (tab bar, switches,
         long presses, sheets) call the vibrator, and without it a tab switch crashed with a SecurityException. -->
    <!-- The WhatsApp vault of this app (plans/wa-vault.md 13.3): androidx.biometric's prompt needs USE_BIOMETRIC on
         API 34; its legacy fingerprint permission goes. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="dev.rosty.action.WA_CALL" />
        </intent>
        <intent>
            <action android:name="dev.rosty.action.WA_CHAT" />
        </intent>
        <!-- WA-R2: the link providers of the sibling Rosty apps (package visibility). -->
        <provider android:authorities="dev.rosty.messages.walink" />
        <provider android:authorities="dev.rosty.phone.walink" />
        <provider android:authorities="dev.rosty.stops.walink" />
    </queries>

    <application
        android:name=".RostyContactsApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rosty">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
        </activity>

        <!-- The people cache for the sibling apps: exported, read and write both behind the signature permission (nothing
             writes). Created before Application.onCreate returns, so it does no work until the first query. -->
        <provider
            android:name=".people.PeopleProvider"
            android:authorities="dev.rosty.contacts.people"
            android:exported="true"
            android:readPermission="dev.rosty.permission.READ_PEOPLE"
            android:writePermission="dev.rosty.permission.READ_PEOPLE" />

        <receiver
            android:name="dev.rosty.bridge.BirthdayReminderReceiver"
            android:exported="false" />

        <!-- People sync v2 S11: WorkManager runs the foreground PeopleSyncWorker in its own service, as dataSync; the
             notification's Stop action is :people's receiver. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <receiver
            android:name="dev.rosty.people.sync.PeopleSyncStopReceiver"
            android:exported="false" />

        <!-- Images and files handed to the share sheet (cache/share only, read-only). -->
        <!-- WA-R2: this app's WhatsApp link for the sibling Rosty apps. Exported, read and write both behind the
             signature permission (nothing writes); it does no work until the first query. -->
        <provider
            android:name="dev.rosty.wa.share.WaLinkProvider"
            android:authorities="${applicationId}.walink"
            android:exported="true"
            android:readPermission="dev.rosty.permission.WA_LINK"
            android:writePermission="dev.rosty.permission.WA_LINK" />
        <!-- Round 7c: a sibling's "Lock now" reaches this app even when it is not running (WaLockAll). Only an app
             signed like this one holds WA_LINK, so only a sibling can send it; the intent carries nothing. -->
        <receiver
            android:name="dev.rosty.wa.share.WaLockAllReceiver"
            android:exported="true"
            android:permission="dev.rosty.permission.WA_LINK">
            <intent-filter>
                <action android:name="dev.rosty.action.WA_LOCK_ALL" />
            </intent-filter>
        </receiver>
        <provider
            android:name="dev.rosty.bridge.RostyShareProvider"
            android:authorities="${applicationId}.rostyshare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
