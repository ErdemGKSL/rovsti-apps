<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt from apps/contacts/platforms/android/app/src/main/AndroidManifest.xml (E4.1): same components, filters,
     queries and flags; the dev.gpui.* pieces and the vulkan uses-feature are gone. ContactsManifestTest compares the merged
     result with platform/src/test/resources/manifest/contacts.permissions.txt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Chat and call on WhatsApp are handed to Rovsti Messages and Phone. Only
         apps signed with the same key hold this (whichever installs first defines it). -->
    <uses-permission android:name="dev.rovsti.permission.HANDOFF" />
    <permission
        android:name="dev.rovsti.permission.HANDOFF"
        android:protectionLevel="signature" />

    <!-- The people cache of X.1b (WhatsApp names and photos) is read by Rovsti Phone through PeopleProvider. Same rule as
         HANDOFF: signature level, declared by both apps, so only apps signed with the same key can read it. This app
         owns the provider and needs no uses-permission; :people's library manifest carries one for the readers. -->
    <permission
        android:name="dev.rovsti.permission.READ_PEOPLE"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rovsti.permission.READ_PEOPLE" tools:node="remove" />

    <!-- :platform mirrors the permissions of all four apps so lint can check its calls; this app does not use
         location or full-screen intents, so the merge drops them. VIBRATE stays: :design's haptics (tab bar, switches,
         long presses, sheets) call the vibrator, and without it a tab switch crashed with a SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="dev.rovsti.action.WA_CALL" />
        </intent>
        <intent>
            <action android:name="dev.rovsti.action.WA_CHAT" />
        </intent>
    </queries>

    <application
        android:name=".RovstiContactsApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rovsti">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
        </activity>

        <!-- The people cache for the sibling apps: exported, read and write both behind the signature permission (nothing
             writes). Created before Application.onCreate returns, so it does no work until the first query. -->
        <provider
            android:name=".people.PeopleProvider"
            android:authorities="dev.rovsti.contacts.people"
            android:exported="true"
            android:readPermission="dev.rovsti.permission.READ_PEOPLE"
            android:writePermission="dev.rovsti.permission.READ_PEOPLE" />

        <receiver
            android:name="dev.rovsti.bridge.BirthdayReminderReceiver"
            android:exported="false" />

        <!-- Images and files handed to the share sheet (cache/share only, read-only). -->
        <provider
            android:name="dev.rovsti.bridge.RovstiShareProvider"
            android:authorities="${applicationId}.rovstishare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
