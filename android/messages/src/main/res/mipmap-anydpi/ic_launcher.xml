<?xml version="1.0" encoding="utf-8"?>
<!-- Vector gradient background and the flat glyph; the liquid-glass glyph art (image-gen, drawable-nodpi/ic_launcher_art)
     replaces the foreground once it is made (image generation is not available on the Messages thread's machine). The
     flat vector glyph stays the monochrome layer for themed icons (Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
