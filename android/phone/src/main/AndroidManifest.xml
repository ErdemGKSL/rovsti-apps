<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt from apps/phone/platforms/android/app/src/main/AndroidManifest.xml (E5.1): the same permissions, queries,
     components, filters and flags with the same class names; the dev.gpui.* pieces and the vulkan uses-feature are gone.
     PhoneManifestTest compares the merged result of both flavors with platform/src/test/resources/manifest/
     phone.permissions.txt and with the GPUI file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <permission
        android:name="dev.rovsti.permission.HANDOFF"
        android:protectionLevel="signature" />

    <!-- :platform mirrors the permissions of all four apps so lint can check its calls; this app does not use
         location, so the merge drops them. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- Package visibility (AD-34): exactly the three intents resolveActivity must see, plus the WhatsApp hand-off
         actions of the sibling apps. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.telephony.action.EMERGENCY_ASSISTANCE" />
        </intent>
        <intent>
            <action android:name="android.settings.HEARING_DEVICES_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.telecom.action.SHOW_CALL_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".RovstiPhoneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rovsti">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|fontScale|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- WhatsApp hand-off from a sibling Rovsti app: only same-signed apps hold the permission. -->
        <activity-alias
            android:name=".WaHandoff"
            android:exported="true"
            android:permission="dev.rovsti.permission.HANDOFF"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="dev.rovsti.action.WA_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".RovstiInCallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Keeps the microphone usable in the background during a WhatsApp call (docs/kotlin-ui/wa-call-audio.md). -->
        <service
            android:name="dev.rovsti.platform.wa.WaCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Answer, Decline and Hang up of the WhatsApp call notifications: broadcasts work on the lock screen. -->
        <receiver
            android:name=".wa.WaCallActionReceiver"
            android:exported="false" />

        <!-- Voicemail count (AD-33, AD-34). Ships disabled; spike S9 enables it with setComponentEnabledSetting. The
             system sends this broadcast and holds READ_PHONE_STATE, which keeps other apps from spoofing it. -->
        <receiver
            android:name=".VoicemailReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.telephony.action.SHOW_VOICEMAIL_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Call-back reminder alarms (inexact, no boot receiver; re-armed at launch). -->
        <receiver
            android:name="dev.rovsti.bridge.CallReminderReceiver"
            android:exported="false" />

        <!-- Images handed to the share sheet (cache/share only, read-only). -->
        <provider
            android:name="dev.rovsti.bridge.RovstiShareProvider"
            android:authorities="${applicationId}.rovstishare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
