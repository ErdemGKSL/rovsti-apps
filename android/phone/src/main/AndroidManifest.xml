<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt from apps/phone/platforms/android/app/src/main/AndroidManifest.xml (E5.1): the same permissions, queries,
     components, filters and flags with the same class names; the dev.gpui.* pieces and the vulkan uses-feature are gone.
     PhoneManifestTest compares the merged result of both flavors with platform/src/test/resources/manifest/
     phone.permissions.txt and with the GPUI file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Phone without Contacts runs its people sync as a dataSync foreground service (people sync v2 S11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <permission
        android:name="dev.rosty.permission.HANDOFF"
        android:protectionLevel="signature" />

    <!-- The people cache of Rosty Contacts (X.1b, WhatsApp names and photos): signature level like HANDOFF, declared by
         both apps so whichever installs first defines it; only apps signed with the same key can read the provider. -->
    <permission
        android:name="dev.rosty.permission.READ_PEOPLE"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rosty.permission.READ_PEOPLE" />

    <!-- WA-R2: the WhatsApp link (gateway address, instance id, connect key) is handed between Rosty apps signed with
         the same key, so linking once links them all (pasting the key stays possible). Signature level, declared by
         every app so whichever installs first defines it. :wa's WaLinkProvider (below) is reachable only with it and
         checks the caller's signing certificate itself. -->
    <permission
        android:name="dev.rosty.permission.WA_LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rosty.permission.WA_LINK" />

    <!-- WA-R2: "Message" on a person opens the chat in Rosty Messages; its hand-off alias asks for HANDOFF. Messages
         is visible through its link provider below, so no intent query is added. -->
    <uses-permission android:name="dev.rosty.permission.HANDOFF" />

    <!-- :platform mirrors the permissions of all four apps so lint can check its calls; this app does not use
         location, so the merge drops them. -->
    <!-- The WhatsApp vault of this app (plans/wa-vault.md 13.3): androidx.biometric's prompt needs USE_BIOMETRIC on
         API 34; its legacy fingerprint permission goes. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- Package visibility (AD-34): exactly the three intents resolveActivity must see, plus the WhatsApp hand-off
         actions of the sibling apps. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.telephony.action.EMERGENCY_ASSISTANCE" />
        </intent>
        <intent>
            <action android:name="android.settings.HEARING_DEVICES_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.telecom.action.SHOW_CALL_SETTINGS" />
        </intent>
        <!-- WA-R2: the link providers of the sibling Rosty apps (package visibility). -->
        <provider android:authorities="dev.rosty.messages.walink" />
        <provider android:authorities="dev.rosty.contacts.walink" />
        <provider android:authorities="dev.rosty.stops.walink" />
    </queries>

    <application
        android:name=".RostyPhoneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rosty">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|fontScale|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- WhatsApp hand-off from a sibling Rosty app: only same-signed apps hold the permission. -->
        <activity-alias
            android:name=".WaHandoff"
            android:exported="true"
            android:permission="dev.rosty.permission.HANDOFF"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="dev.rosty.action.WA_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".RostyInCallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Keeps the microphone usable in the background during a WhatsApp call (docs/kotlin-ui/wa-call-audio.md). -->
        <service
            android:name="dev.rosty.platform.wa.WaCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <!-- People sync v2 S11 (Phone without Contacts): WorkManager runs the foreground PhonePeopleSyncWorker in its own
             service, as dataSync (the call services above keep their own types); the notification's Stop action is
             :people's receiver. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- WorkManager starts on demand (RostyPhoneApp is its Configuration.Provider), not at every process start:
             a cold start for a ringing call must not open its database. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <receiver
            android:name="dev.rosty.people.sync.PeopleSyncStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Answer, Decline and Hang up of the WhatsApp call notifications: broadcasts work on the lock screen. -->
        <receiver
            android:name=".wa.WaCallActionReceiver"
            android:exported="false" />

        <!-- Voicemail count (AD-33, AD-34). Ships disabled; spike S9 enables it with setComponentEnabledSetting. The
             system sends this broadcast and holds READ_PHONE_STATE, which keeps other apps from spoofing it. -->
        <receiver
            android:name=".VoicemailReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.telephony.action.SHOW_VOICEMAIL_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Call-back reminder alarms (exact while the exact-alarm permission is granted, else inexact). -->
        <receiver
            android:name="dev.rosty.bridge.CallReminderReceiver"
            android:exported="false" />

        <!-- E5.12: a reboot, an update or a change of the exact-alarm permission clears the alarms; this sets them again
             from the stored reminders. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Images handed to the share sheet (cache/share only, read-only). -->
        <!-- WA-R2: this app's WhatsApp link for the sibling Rosty apps. Exported, read and write both behind the
             signature permission (nothing writes); it does no work until the first query. -->
        <provider
            android:name="dev.rosty.wa.share.WaLinkProvider"
            android:authorities="${applicationId}.walink"
            android:exported="true"
            android:readPermission="dev.rosty.permission.WA_LINK"
            android:writePermission="dev.rosty.permission.WA_LINK" />
        <provider
            android:name="dev.rosty.bridge.RostyShareProvider"
            android:authorities="${applicationId}.rostyshare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
