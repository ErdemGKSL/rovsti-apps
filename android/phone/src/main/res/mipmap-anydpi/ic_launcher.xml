<?xml version="1.0" encoding="utf-8"?>
<!-- Glass glyph art (image-gen, full-bleed square) inset into the 66 dp safe zone over the matching vector gradient;
     the flat vector glyph is the monochrome layer for themed icons (Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_art" android:inset="20%" />
    </foreground>
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
