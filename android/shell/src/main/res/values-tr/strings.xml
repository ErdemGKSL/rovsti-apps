    <!-- Rationale sheet: title and body per group -->
    <string name="permission_rationale_phone_title">Buradan arama yapın</string>
    <string name="permission_rationale_phone_body">Rovsti, arama yapabilmek ve bir aramanın ne zaman başlayıp bittiğini bilebilmek için telefon iznine ihtiyaç duyar. Aramalar hiçbir zaman telefonunuzdan çıkmaz.</string>
    <string name="permission_rationale_contacts_title">Kişilerinizi görün</string>
    <string name="permission_rationale_contacts_body">Kişiler, Rovsti\'nin numaralar yerine ad ve fotoğrafları göstermesini sağlar. Kişileriniz bu telefonda kalır.</string>
    <string name="permission_rationale_notifications_title">Gelişmelerden haberdar olun</string>
    <string name="permission_rationale_notifications_body">Bildirimler cevapsız aramalar ve yeni mesajlar hakkında sizi bilgilendirir. İstediğiniz zaman kapatabilirsiniz.</string>
    <string name="permission_rationale_call_log_title">Arama geçmişinizi gösterin</string>
    <string name="permission_rationale_call_log_body">Rovsti, son aramaları listelemek için bu telefondaki arama geçmişini okur. Hiçbir şey karşıya yüklenmez.</string>
    <string name="permission_rationale_bluetooth_title">Bluetooth ses kullanın</string>
    <string name="permission_rationale_bluetooth_body">Bluetooth, bir aramanın kulaklığınıza veya arabanıza geçmesini sağlar. Rovsti yalnızca daha önce eşleştirdiğiniz cihazlarla iletişim kurar.</string>
    <string name="permission_rationale_location_title">Bulunduğunuz yeri bulun</string>
    <string name="permission_rationale_location_body">Konumunuz, sizi haritada göstermek ve durağınızdan önce uyandırmak için kullanılır. Paylaşılmaz.</string>
    <string name="permission_rationale_background_location_title">Yolculuğunuzu takip etmeye devam edin</string>
    <string name="permission_rationale_background_location_body">Ekran kapalıyken sizi durağınızdan önce uyandırmak için Rovsti\'nin yolculuk boyunca her zaman konum erişimine ihtiyacı vardır.</string>
    <string name="permission_rationale_microphone_title">Konuşun ve sesli not gönderin</string>
    <string name="permission_rationale_microphone_body">Mikrofon yalnızca kullandığınız sırada WhatsApp aramaları ve sesli notlar için kullanılır.</string>

