    <!-- Rationale sheet: title and body per group -->
    <string name="permission_rationale_phone_title">Make calls from here</string>
    <string name="permission_rationale_phone_body">Rovsti needs the phone permission to place calls and to know when a call starts or ends. Calls never leave your phone.</string>
    <string name="permission_rationale_contacts_title">See your contacts</string>
    <string name="permission_rationale_contacts_body">Contacts lets Rovsti show names and photos instead of numbers. Your contacts stay on this phone.</string>
    <string name="permission_rationale_notifications_title">Stay in the loop</string>
    <string name="permission_rationale_notifications_body">Notifications tell you about missed calls and new messages. You can turn them off any time.</string>
    <string name="permission_rationale_call_log_title">Show your call history</string>
    <string name="permission_rationale_call_log_body">Rovsti reads the call history on this phone to list recent calls. Nothing is uploaded.</string>
    <string name="permission_rationale_bluetooth_title">Use Bluetooth audio</string>
    <string name="permission_rationale_bluetooth_body">Bluetooth lets a call move to your headset or car. Rovsti only talks to devices you already paired.</string>
    <string name="permission_rationale_location_title">Find where you are</string>
    <string name="permission_rationale_location_body">Your location is used to show you on the map and to wake you before your stop. It is not shared.</string>
    <string name="permission_rationale_background_location_title">Keep watching your trip</string>
    <string name="permission_rationale_background_location_body">To wake you before your stop while the screen is off, Rovsti needs location access all the time during a trip.</string>
    <string name="permission_rationale_microphone_title">Speak and send voice notes</string>
    <string name="permission_rationale_microphone_body">The microphone is used for WhatsApp calls and voice notes, only while you use them.</string>

