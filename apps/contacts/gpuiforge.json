{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Contacts"
  },
  "platforms": {
    "android": {
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "application-id": "dev.rovsti.contacts",
      "features": [
        "sharing"
      ],
      "icon": "assets/app.png",
      "management": "manual",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "project-dir": "platforms/android",
      "share-mime-types": [
        "text/x-vcard",
        "text/vcard",
        "text/directory"
      ],
      "variables": {
        "min_sdk": "34",
        "target_sdk": "36"
      },
      "activity": "dev.rovsti.contacts.MainActivity",
      "signing": {
        "keystore": "/home/erdem/ownCloud/Personal/rovsti/rovsti-release.jks",
        "key-alias": "rovsti",
        "store-password-env": "ANDROID_STORE_PASSWORD",
        "key-password-env": "ANDROID_KEY_PASSWORD"
      }
    },
    "desktop": {
      "build": [
        {
          "args": [
            "build",
            "-p",
            "rovsti_contacts",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ],
      "run": [
        {
          "args": [
            "run",
            "-p",
            "rovsti_contacts",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ]
    }
  }
}
