{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Contacts"
  },
  "platforms": {
    "android": {
      "abis": ["arm64-v8a", "x86_64"],
      "application-id": "dev.rovsti.contacts",
      "features": ["sharing"],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "desktop": {
      "build": [{ "program": "cargo", "args": ["build", "-p", "rovsti_contacts", "--profile", "{{cargo_profile}}"] }],
      "run": [{ "program": "cargo", "args": ["run", "-p", "rovsti_contacts", "--profile", "{{cargo_profile}}"] }]
    }
  }
}
