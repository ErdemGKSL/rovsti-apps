{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Contacts"
  },
  "platforms": {
    "android": {
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "application-id": "dev.rovsti.contacts",
      "features": [
        "sharing"
      ],
      "management": "manual",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "project-dir": "platforms/android",
      "variables": {
        "min_sdk": "34",
        "target_sdk": "36"
      },
      "activity": "dev.rovsti.contacts.MainActivity"
    },
    "desktop": {
      "build": [
        {
          "args": [
            "build",
            "-p",
            "rovsti_contacts",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ],
      "run": [
        {
          "args": [
            "run",
            "-p",
            "rovsti_contacts",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ]
    }
  }
}
