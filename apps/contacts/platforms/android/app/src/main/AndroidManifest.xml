<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Chat and call on WhatsApp are handed to Rovsti Messages and Phone. Only
         apps signed with the same key hold this (whichever installs first defines it). -->
    <uses-permission android:name="dev.rovsti.permission.HANDOFF" />
    <permission
        android:name="dev.rovsti.permission.HANDOFF"
        android:protectionLevel="signature" />

    <queries>
        <intent>
            <action android:name="dev.rovsti.action.WA_CALL" />
        </intent>
        <intent>
            <action android:name="dev.rovsti.action.WA_CHAT" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <application
        android:name=".RovstiContactsApp"
        android:label="Rovsti Contacts"
        android:icon="@drawable/gpui_app_icon"
        android:roundIcon="@drawable/gpui_app_icon"
        android:theme="@style/GpuiTheme"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|fontScale|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name="dev.rovsti.bridge.BirthdayReminderReceiver" android:exported="false" />

        <!-- Images and files handed to the share sheet (cache/share only, read-only). -->
        <provider
            android:name="dev.rovsti.bridge.RovstiShareProvider"
            android:authorities="${applicationId}.rovstishare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
