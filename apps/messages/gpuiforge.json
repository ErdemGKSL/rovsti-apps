{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Messages"
  },
  "platforms": {
    "android": {
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "activity": "dev.rovsti.messages.MainActivity",
      "application-id": "dev.rovsti.messages",
      "features": [
        "network",
        "sharing",
        "notifications"
      ],
      "icon": "assets/app.png",
      "management": "manual",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECEIVE_MMS",
        "android.permission.RECEIVE_WAP_PUSH",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.INTERNET"
      ],
      "project-dir": "platforms/android",
      "share-mime-types": [
        "text/plain",
        "image/*"
      ],
      "url-schemes": [
        "sms",
        "smsto",
        "mms",
        "mmsto"
      ],
      "variables": {
        "min_sdk": "34",
        "target_sdk": "36"
      },
      "signing": {
        "keystore": "/home/erdem/.config/rovsti/rovsti-release.jks",
        "key-alias": "rovsti",
        "store-password-env": "ANDROID_STORE_PASSWORD",
        "key-password-env": "ANDROID_KEY_PASSWORD"
      }
    },
    "desktop": {
      "build": [
        {
          "program": "cargo",
          "args": [
            "build",
            "-p",
            "rovsti_messages",
            "--profile",
            "{{cargo_profile}}"
          ]
        }
      ],
      "run": [
        {
          "program": "cargo",
          "args": [
            "run",
            "-p",
            "rovsti_messages",
            "--profile",
            "{{cargo_profile}}"
          ]
        }
      ]
    }
  }
}
