{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Stops"
  },
  "platforms": {
    "android": {
      "abis": ["arm64-v8a", "x86_64"],
      "application-id": "dev.rovsti.stops",
      "features": ["notifications", "audio-playback"],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "url-schemes": ["geo"]
    },
    "desktop": {
      "build": [{ "program": "cargo", "args": ["build", "-p", "rovsti_stops", "--profile", "{{cargo_profile}}"] }],
      "run": [{ "program": "cargo", "args": ["run", "-p", "rovsti_stops", "--profile", "{{cargo_profile}}"] }]
    }
  }
}
