{
  "$schema": "https://raw.githubusercontent.com/cradiy/gpuiforge/main/gpuiforge.schema.json",
  "app": {
    "name": "Rovsti Stops"
  },
  "platforms": {
    "android": {
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "application-id": "dev.rovsti.stops",
      "features": [
        "notifications",
        "audio-playback"
      ],
      "icon": "assets/app.png",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "url-schemes": [
        "geo"
      ],
      "management": "manual",
      "project-dir": "platforms/android",
      "variables": {
        "min_sdk": "34",
        "target_sdk": "36"
      },
      "activity": "dev.rovsti.stops.MainActivity",
      "signing": {
        "keystore": "/home/erdem/.config/rovsti/rovsti-release.jks",
        "key-alias": "rovsti",
        "store-password-env": "ANDROID_STORE_PASSWORD",
        "key-password-env": "ANDROID_KEY_PASSWORD"
      }
    },
    "desktop": {
      "build": [
        {
          "program": "cargo",
          "args": [
            "build",
            "-p",
            "rovsti_stops",
            "--profile",
            "{{cargo_profile}}"
          ]
        }
      ],
      "run": [
        {
          "program": "cargo",
          "args": [
            "run",
            "-p",
            "rovsti_stops",
            "--profile",
            "{{cargo_profile}}"
          ]
        }
      ]
    }
  }
}
